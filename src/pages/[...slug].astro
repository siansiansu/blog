---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const dateStr = post.data.pubDate.toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image}>
  <div class="post-layout">
    <article class="post-content">
      <header class="post-header">
        <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
        <h1>{post.data.title}</h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${tag}/`} class="tag">{tag}</a>
            ))}
          </div>
        )}
      </header>
      <div class="content">
        <Content />
      </div>
    </article>
    <aside class="toc-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: 'Bîn-hiân' },
    publisher: { '@type': 'Organization', name: 'Bîn-hiân ê 簿仔紙' },
  })} />
</BaseLayout>

<style>
  .post-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 72rem) {
    .post-layout {
      grid-template-columns: minmax(0, 800px) 220px;
    }
  }

  .toc-sidebar {
    display: none;
  }

  @media (min-width: 72rem) {
    .toc-sidebar {
      display: block;
    }
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global([data-theme='dark']) .post-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  time {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0.5rem 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  :global([data-theme='dark']) .tag {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .tag:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 10px;
    margin: 1rem 0;
  }

  .content :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .content :global(pre) {
    border-radius: 10px;
    margin: 1.5rem 0;
  }

  .content :global(blockquote) {
    border-left: 4px solid var(--color-text);
    background: rgba(0, 0, 0, 0.02);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 10px;
  }
</style>
