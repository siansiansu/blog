---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description?: string;
  tags?: string[];
}

const { title, slug, pubDate, description, tags } = Astro.props;
const dateStr = pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="post-card">
  <a href={`/${slug}/`} class="post-link">
    <time datetime={pubDate.toISOString()}>{dateStr}</time>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
    {tags && tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
  </a>
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global([data-theme='dark']) .post-card {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-link:hover h2 {
    color: var(--color-text-secondary);
  }

  time {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0.25rem 0 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .tag {
    background-color: rgba(255, 255, 255, 0.08);
  }
</style>
