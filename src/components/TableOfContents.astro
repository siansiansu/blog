---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 0 && (
  <nav class="toc">
    <h4 class="toc-title">目錄</h4>
    <ul>
      {toc.map((h) => (
        <li class={h.depth === 3 ? 'indent' : ''}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: 1rem 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin-bottom: 0.25rem;
  }

  li.indent {
    padding-left: 1rem;
  }

  a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    display: block;
    padding: 0.125rem 0;
  }

  a:hover {
    color: var(--color-text);
  }
</style>
